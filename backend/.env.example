# SMTP settings for delivery to real inboxes.
# Without these values, the application uses Ethereal, a safe test inbox; the
# API returns a preview URL instead of delivering the message to the recipient.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Nordwerk Treasury <treasury@example.com>"
